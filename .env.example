# The default local setup uses the authenticated Codex CLI installed by npm.
# AI_PROVIDER=codex-cli
# AI_MODEL=                         # optional; blank uses your Codex account default
# CODEX_BIN=                        # optional absolute path; local node_modules/.bin/codex is used

# Alternative API setup (server-only secrets; NEVER use a VITE_ prefix):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=

# Or: AI_PROVIDER=openai, AI_MODEL=<available API model>, AI_API_KEY=<secret>
# AI requests run only after explicit consent/action and the service accepts localhost only.
