# Copy to .env.local; never use VITE_ prefixes for secrets.
# Both variables must match a model available through your provider's API.
# Development CLI subscriptions do not automatically grant API access.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# Alternative: AI_PROVIDER=openai, AI_MODEL=<your available API model ID>
# AI requests run only on explicit learner action, from localhost.
